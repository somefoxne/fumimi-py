# Discord credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Danbooru configuration (Production)
BOORU_URL=https://danbooru.donmai.us
BOORU_USER=your_danbooru_username
BOORU_API_KEY=your_danbooru_api_key

# Test mode (Đặt là true nếu muốn dùng testbooru để test)
TEST_MODE=false
TEST_BOORU_URL=https://testbooru.donmai.us
TEST_BOORU_USER=your_testbooru_username
TEST_BOORU_API_KEY=your_testbooru_api_key
BOORU_USER_ID=
